# ── Telegram ──────────────────────────────────────────────
# Get a token from @BotFather. NEVER commit the real .env file.
BOT_TOKEN=1234567890:REPLACE_WITH_YOUR_BOT_TOKEN
BOT_NAME=اخبار هوشمند

# Comma-separated Telegram numeric user IDs allowed to use /stats and the admin panel
ADMIN_IDS=

# Optional: restrict admin-panel phone authentication to these numbers.
# Leave EMPTY to allow admin authentication with ANY shared phone number (default).
# Example: ADMIN_PHONES=+989121234567,+989351112233
ADMIN_PHONES=

# ── Storage & locale ─────────────────────────────────────
DB_PATH=data/bot.db
TIMEZONE=Asia/Tehran

# ── News delivery schedule (24h, comma-separated) ────────
SCHEDULE_TIMES=08:00,13:30,20:00

# ── News sources & digest ────────────────────────────────
SOURCES_FILE=sources.json
NEWS_PER_DIGEST=8
# How many admin-authored news items to include per delivery
CUSTOM_NEWS_LIMIT=5
FEED_TIMEOUT=12
CACHE_TTL=300

# ── AI summary (optional, OpenAI-compatible endpoint) ────
# Leave OPENAI_API_KEY empty to use the built-in extractive fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
